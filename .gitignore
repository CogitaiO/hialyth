/test/failures/

# Generated iOS configuration contains machine-specific SDK and checkout paths.
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/ephemeral/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/build/
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing material must stay outside version control.
*.jks
*.keystore
key.properties
/.env/

/nekaido_lib.txt

# Local tool preferences and instruction backups
/devtools_options.yaml
/AGENTS.md.backup
/AGENTS.md.bak-*
